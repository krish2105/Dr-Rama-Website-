# Copy to .env.local. Nothing here is committed. Leave blank to use the dev mock handlers.
# Production: https://rajeshhomoeohome.in (domain printed on the clinic business card)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GA_ID=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
BOOKING_ALERT_TO=
BOOKING_ALERT_FROM=
# Search engines stay blocked until this is "true". Set it at launch, with the real domain.
NEXT_PUBLIC_INDEXABLE=false
# Kill switch for all animation: set to "off" to disable motion for every visitor.
NEXT_PUBLIC_MOTION_LEVEL=
