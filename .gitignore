node_modules
.next
.env
.env.local
*.tsbuildinfo
next-env.d.ts
.DS_Store
# Real clinic photos and the CV are private source material; publish only via public/photos after approval
source/cv/*
!source/cv/.gitkeep
# Private until the people in them consent / not for publication
source/reference/*
source/photos/_pending-consent/*
!source/reference/.gitkeep
!source/photos/_pending-consent/.gitkeep
# Large originals of generated artwork (optimised copies live in public/art)
source/art/*
!source/art/.gitkeep

# Word files and lock files stay local (prompt packs are for the owner)
*.docx
~$*
*.zip
